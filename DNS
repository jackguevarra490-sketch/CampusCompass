; ====================================================================
; Cloudflare Optimized DNS Zone File (RFC 1035 Standard)
; Institution: City College of San Jose Del Monte (CCSJDM)
; Domain: ccsjdm.com
; Deployment Target: Cloudflare Pages (ccsjdm-compass.pages.dev)
; Cloudflare Proxy: ENABLED (Orange Cloud / CDN / WAF / Auto SSL)
; ====================================================================

$ORIGIN ccsjdm.com.
$TTL 1

; --- Start of Authority (SOA) Managed by Cloudflare ---
@   IN  SOA dave.ns.cloudflare.com. dns.cloudflare.com. (
            2026101401 ; Serial
            10000      ; Refresh
            2400       ; Retry
            604800     ; Expire
            3600 )     ; Minimum TTL

; --- Cloudflare Authoritative Anycast Nameservers ---
@   IN  NS  dave.ns.cloudflare.com.
@   IN  NS  zoe.ns.cloudflare.com.

; --- Apex & Subdomain Routing (Cloudflare CNAME Flattening) ---
@       IN  CNAME   ccsjdm-compass.pages.dev. ; cf_proxy:true
www     IN  CNAME   ccsjdm-compass.pages.dev. ; cf_proxy:true
portal  IN  CNAME   ccsjdm-compass.pages.dev. ; cf_proxy:true
campus  IN  CNAME   ccsjdm-compass.pages.dev. ; cf_proxy:true
app     IN  CNAME   ccsjdm-compass.pages.dev. ; cf_proxy:true

; --- Direct Fallback Origin ---
api     IN  CNAME   ais-pre-wjck3mvky6vst4ozkkpre5-651101265493.asia-east1.run.app. ; cf_proxy:true

; --- Verification & TXT Records ---
@       IN  TXT "google-site-verification=ccsjdm-compass-2026-auth-verification"
@       IN  TXT "cloudflare-pages-verification=ccsjdm-compass"
@       IN  TXT "cf-custom-domain=ccsjdm.com"

; --- Email Routing: Cloudflare Email Routing ---
@   IN  MX  1   isaac.mx.cloudflare.net.
@   IN  MX  5   linda.mx.cloudflare.net.
@   IN  MX  10  amir.mx.cloudflare.net.

; --- SPF & DMARC Protection ---
@       IN  TXT "v=spf1 include:_spf.mx.cloudflare.net ~all"
_dmarc  IN  TXT "v=DMARC1; p=quarantine; sp=quarantine; rua=mailto:admin@ccsjdm.com"

; --- Certificate Authority Authorization (Universal SSL) ---
@   IN  CAA 0 issue "letsencrypt.org"
@   IN  CAA 0 issue "digicert.com"
@   IN  CAA 0 issue "sectigo.com"
@   IN  CAA 0 issue "pki.goog"
@   IN  CAA 0 iodef "mailto:security@ccsjdm.com"
